# Local development only. Copy to .env and adjust if needed — matches docker-compose.yml's dev
# credentials. Real secrets are never committed and never live here; production secrets come from
# AWS Secrets Manager (CLAUDE.md rule 6).

NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://truepath:truepath@localhost:5432/truepath

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=truepath
CLICKHOUSE_PASSWORD=truepath
CLICKHOUSE_DB=truepath

REDIS_DURABLE_URL=redis://localhost:6379
REDIS_CACHE_URL=redis://localhost:6380

API_PORT=3000
COLLECTOR_PORT=3001
